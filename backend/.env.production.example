# Branch images published by GitHub Actions after CI passes.
FRONTEND_IMAGE=ghcr.io/conradocmatheus/contact-manager-front:dev
BACKEND_IMAGE=ghcr.io/conradocmatheus/contact-manager-back:dev

# Use http://ELASTIC_IP initially. Replace it with the HTTPS domain later.
SITE_ADDRESS=http://YOUR_ELASTIC_IP
CORS_ORIGIN=http://YOUR_ELASTIC_IP

# Use a URL-safe password, such as the output of: openssl rand -hex 32
POSTGRES_DB=contacts_manager
POSTGRES_USER=contact_manager
POSTGRES_PASSWORD=replace-with-a-url-safe-password
DATABASE_URL=postgresql://contact_manager:replace-with-the-same-password@db:5432/contacts_manager?schema=public

# Generate an independent value with: openssl rand -hex 64
JWT_SECRET=replace-with-a-long-random-secret
BCRYPT_SALT_ROUNDS=10

# Optional. Phone validation returns 503 when the key is empty.
NUMVERIFY_API_KEY=
NUMVERIFY_API_URL=https://api.apilayer.com/number_verification/validate
